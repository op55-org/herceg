      },
      "marks": [{ "type": "line", "x": "time", "y": "orders", "data": "data3" }]
    },
    "regions": {
      "version": 1,
      "x": { "domain": ["North", "South", "East", "West"] },
      "tooltip": true,
      "interaction": { "select": "items" },
