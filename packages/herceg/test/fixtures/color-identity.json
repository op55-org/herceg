{
  "about": "What series and slices stand for, as the legend's entries' keys and labels in order: a category field of one name gives a value one entry across marks, tables, and panels; value fields stand for their labels within their table (or the table it is made from, `origin`); named scales join or keep apart by value. Each case's spec is what the Python calls make (python/tests/test_conformance.py builds it and compares); the engine draws it and lists the entries (packages/herceg/test/model/conformance.test.ts).",
  "cases": [
    {
      "name": "a line, bars, an area, and a pie of one table's region",
      "spec": {
        "data": {
          "data": {
            "columns": { "t": [0, 1, 0, 1], "region": ["eu", "eu", "us", "us"], "v": [1, 2, 3, 4] }
          }
        },
        "panels": [{ "id": "a" }, { "id": "b" }, { "id": "c" }, { "id": "d" }],
        "x": { "scope": "panel" },
        "marks": [
          { "type": "line", "x": "t", "y": "v", "color": "region", "panel": "a", "data": "data" },
          { "type": "bar", "x": "t", "y": "v", "color": "region", "panel": "b", "data": "data" },
          { "type": "area", "x": "t", "y": "v", "series": "region", "panel": "c", "data": "data" },
          { "type": "pie", "category": "region", "value": "v", "panel": "d", "data": "data" }
        ]
      },
      "python": [
        { "method": "line", "args": { "x": "t", "y": "v", "color": "region", "panel": "a" } },
        { "method": "bar", "args": { "x": "t", "y": "v", "color": "region", "panel": "b" } },
        { "method": "area", "args": { "x": "t", "y": "v", "series": "region", "panel": "c" } },
        { "method": "pie", "args": { "category": "region", "value": "v", "panel": "d" } }
      ],
      "entries": [
        ["{\"field\":\"region\",\"value\":\"eu\"}", "eu"],
        ["{\"field\":\"region\",\"value\":\"us\"}", "us"]
      ]
    },
    {
      "name": "value fields, by their labels",
      "spec": {
        "data": {
          "data": {
            "columns": { "t": [0, 1], "p50": [1, 2], "p99": [3, 4], "lo": [0, 1], "hi": [2, 3] }
          }
        },
        "marks": [
          { "type": "line", "x": "t", "y": ["p50", "p99"], "data": "data" },
          { "type": "area", "x": "t", "y1": "lo", "y2": "hi", "label": "p50", "data": "data" }
        ]
      },
      "python": [
        { "method": "line", "args": { "x": "t", "y": ["p50", "p99"] } },
        { "method": "area", "args": { "y1": "lo", "y2": "hi", "x": "t", "label": "p50" } }
      ],
      "entries": [
        ["{\"table\":\"data\",\"value\":\"p50\"}", "p50"],
        ["{\"table\":\"data\",\"value\":\"p99\"}", "p99"]
      ]
    },
    {
      "name": "a field's name shares its values across tables",
      "spec": {
        "data": {
          "data": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [1, 2] } },
          "data2": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [3, 4] } },
          "data3": {
            "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [5, 6] },
            "origin": "data"
          }
        },
        "marks": [
          { "type": "line", "x": "t", "y": "v", "series": "region", "data": "data" },
          { "type": "line", "x": "t", "y": "v", "series": "region", "data": "data2" },
          { "type": "line", "x": "t", "y": "v", "series": "region", "data": "data3" }
        ]
      },
      "entries": [
        ["{\"field\":\"region\",\"value\":\"eu\"}", "eu"],
        ["{\"field\":\"region\",\"value\":\"us\"}", "us"]
      ]
    },
    {
      "name": "value fields of unrelated tables apart, of a table made from another together",
      "spec": {
        "data": {
          "data": { "columns": { "t": [0, 1], "v": [1, 2] } },
          "data2": { "columns": { "t": [0, 1], "v": [3, 4] } },
          "data3": { "columns": { "t": [0, 1], "v": [5, 6] }, "origin": "data" }
        },
        "marks": [
          { "type": "line", "x": "t", "y": "v", "data": "data" },
          { "type": "line", "x": "t", "y": "v", "data": "data2" },
          { "type": "line", "x": "t", "y": "v", "data": "data3" }
        ]
      },
      "entries": [
        ["{\"table\":\"data\",\"value\":\"v\"}", "v"],
        ["{\"table\":\"data2\",\"value\":\"v\"}", "v"]
      ]
    },
    {
      "name": "a named scale joins tables by value",
      "spec": {
        "data": {
          "data": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [1, 2] } },
          "data2": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [3, 4] } }
        },
        "scales": { "regions": { "type": "ordinal" } },
        "marks": [
          {
            "type": "line",
            "x": "t",
            "y": "v",
            "series": "region",
            "encode": { "color": { "field": "region", "scale": "regions" } },
            "data": "data"
          },
          {
            "type": "line",
            "x": "t",
            "y": "v",
            "series": "region",
            "encode": { "color": { "field": "region", "scale": "regions" } },
            "data": "data2"
          }
        ]
      },
      "entries": [
        ["{\"scale\":\"regions\",\"value\":\"eu\"}", "eu"],
        ["{\"scale\":\"regions\",\"value\":\"us\"}", "us"]
      ]
    },
    {
      "name": "named scales keep a field's name apart",
      "spec": {
        "data": {
          "data": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [1, 2] } },
          "data2": { "columns": { "t": [0, 1], "region": ["eu", "us"], "v": [3, 4] } }
        },
        "scales": { "production": { "type": "ordinal" }, "test": { "type": "ordinal" } },
        "marks": [
          {
            "type": "line",
            "x": "t",
            "y": "v",
            "series": "region",
            "encode": { "color": { "field": "region", "scale": "production" } },
            "data": "data"
          },
          {
            "type": "line",
            "x": "t",
            "y": "v",
            "series": "region",
            "encode": { "color": { "field": "region", "scale": "test" } },
            "data": "data2"
          }
        ]
      },
      "entries": [
        ["{\"scale\":\"production\",\"value\":\"eu\"}", "eu"],
        ["{\"scale\":\"production\",\"value\":\"us\"}", "us"],
        ["{\"scale\":\"test\",\"value\":\"eu\"}", "eu"],
        ["{\"scale\":\"test\",\"value\":\"us\"}", "us"]
      ]
    },
    {
      "name": "rows without a category position, in no series (along x)",
      "spec": {
        "data": {
          "data": { "columns": { "p": ["a", null, null], "v": [1, 2, 3], "c": ["eu", "us", "us"] } }
        },
        "panels": [{ "id": "a" }, { "id": "b" }],
        "marks": [
          {
            "type": "line",
            "x": "p",
            "y": "v",
            "series": false,
            "color": "c",
            "panel": "a",
            "data": "data"
          },
          {
            "type": "area",
            "x": "p",
            "y": "v",
            "series": false,
            "color": "c",
            "panel": "b",
            "data": "data"
          }
        ]
      },
      "python": [
        {
          "method": "line",
          "args": { "x": "p", "y": "v", "color": "c", "series": false, "panel": "a" }
        },
        {
          "method": "area",
          "args": { "x": "p", "y": "v", "color": "c", "series": false, "panel": "b" }
        }
      ],
      "entries": [["{\"field\":\"c\",\"value\":\"eu\"}", "eu"]]
    },
    {
      "name": "rows without a category position, in no series (along y)",
      "spec": {
        "data": {
          "data": { "columns": { "p": ["a", null, null], "v": [1, 2, 3], "c": ["eu", "us", "us"] } }
        },
        "panels": [{ "id": "a" }, { "id": "b" }],
        "marks": [
          {
            "type": "line",
            "x": "v",
            "y": "p",
            "orient": "y",
            "series": false,
            "color": "c",
            "panel": "a",
            "data": "data"
          },
          {
            "type": "area",
            "x": "v",
            "y": "p",
            "orient": "y",
            "series": false,
            "color": "c",
            "panel": "b",
            "data": "data"
          }
        ]
      },
      "python": [
        {
          "method": "line",
          "args": { "x": "v", "y": "p", "orient": "y", "color": "c", "series": false, "panel": "a" }
        },
        {
          "method": "area",
          "args": { "x": "v", "y": "p", "orient": "y", "color": "c", "series": false, "panel": "b" }
        }
      ],
      "entries": [["{\"field\":\"c\",\"value\":\"eu\"}", "eu"]]
    }
  ]
}
